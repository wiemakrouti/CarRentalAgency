# Postgres connection used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/car_rental_agence?schema=public"

# App
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"
APP_URL="http://localhost:5173"

# Email (Resend) — leave RESEND_API_KEY empty to run in degraded mode:
# verification/reset emails are logged to the console instead of sent.
RESEND_API_KEY=""
EMAIL_FROM="Car Rental App <onboarding@resend.dev>"

# Auth
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Seed
SEED_ADMIN_EMAIL="admin@agence.tn"
SEED_ADMIN_PASSWORD="ChangeMe123!"
