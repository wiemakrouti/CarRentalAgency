// Prisma schema for the Car Rental Management Dashboard.
// Naming: English identifiers throughout (see docs/business-rules.md for the
// French-UI / English-code convention). Money fields use Decimal(10,3) to match
// TND's 3-decimal (millime) precision.
//
// Soft delete: `deletedAt` marks a record archived instead of removing it.
// `licensePlate`, `vin`, and `email` are only *logically* unique among
// non-archived rows — enforced via partial unique indexes added by hand in the
// initial migration (see migration.sql), since Prisma's schema DSL has no
// partial-unique-index syntax.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ADMIN: the agency's director — every right, plus the team, the activity
// journal and the agency settings. EMPLOYEE: runs the day-to-day work
// (rentals, clients, cars, payments, expenses) under the director's eye.
enum Role {
  ADMIN
  EMPLOYEE
}

enum CarCategory {
  ECONOMY
  COMPACT
  SUV
  LUXURY
  VAN
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum FuelType {
  GASOLINE
  DIESEL
  HYBRID
  ELECTRIC
}

enum CarStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  OUT_OF_SERVICE
}

enum ClientDocumentType {
  ID_CARD
  DRIVING_LICENSE
  PASSPORT
  OTHER
}

// OVERDUE is never written to the database — it's a purely computed,
// read-side condition (status: ACTIVE + plannedReturnDate in the past),
// derived by the frontend and by queries such as the dashboard "overdue
// rentals" widget. Kept as an enum value so those read-side checks and any
// future filter/badge can treat it as a first-class status value.
enum RentalStatus {
  RESERVED
  ACTIVE
  COMPLETED
  CANCELLED
  OVERDUE
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  CHECK
}

enum PaymentType {
  RENTAL_PAYMENT
  DEPOSIT
  DEPOSIT_REFUND
  EXTENSION_PAYMENT
  LATE_FEE
  DAMAGE_FEE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
}

enum ExpenseCategory {
  FUEL
  INSURANCE
  REPAIR
  REGISTRATION
  OTHER
}

enum MaintenanceType {
  OIL_CHANGE
  TIRE_CHANGE
  REPAIR
  INSPECTION
  CLEANING
  OTHER
}

// One row per agency that has registered (see AuthService.register) — the
// tenant boundary every business table below is scoped to via agencyId.
// Deliberately minimal (no name/contact fields of its own): the agency's
// display identity lives on its Setting row (the "Profil" page), so there's
// exactly one place to edit it instead of two that could drift apart.
model Agency {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  cars             Car[]
  clients          Client[]
  rentals          Rental[]
  payments         Payment[]
  expenses         Expense[]
  setting          Setting?
  auditLogs        AuditLog[]
  approvalRequests ApprovalRequest[]

  @@map("agencies")
}

model User {
  id                 String    @id @default(uuid())
  // Global, not per-agency: login has no agency-selection step, so an email
  // must resolve to exactly one account across the whole deployment.
  email              String    @unique
  passwordHash       String
  fullName           String
  role               Role      @default(ADMIN)
  // Null until the verification email's link is clicked (AuthService.
  // verifyEmail) — non-blocking: an unverified admin can still log in and
  // use the app, this is only surfaced as a dismissible reminder banner.
  emailVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  // Set by the director to cut an employee off (login refused, sessions
  // revoked) without deleting the account — their history stays attributed.
  deactivatedAt      DateTime?
  // True for an account created (or reset) by the director with a temporary
  // password — every request but the password change itself is refused
  // until the employee picks their own.
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id])

  rentalsCreated          Rental[]                 @relation("RentalCreatedBy")
  auditLogs               AuditLog[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  approvalRequests        ApprovalRequest[]        @relation("ApprovalRequestedBy")
  approvalDecisions       ApprovalRequest[]        @relation("ApprovalDecidedBy")

  @@index([agencyId])
  @@map("users")
}

// Single-use, short-lived (24h) token emailed at registration (and on
// request via /auth/resend-verification) — the raw value is only ever
// emailed, never stored; only its SHA-256 hash lives here, same rationale as
// RefreshToken.tokenHash. Consumed (row deleted) the moment it's used, and
// requesting a new one deletes any previous outstanding token for that user
// so at most one is ever valid at a time.
model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

// Same shape and lifecycle as EmailVerificationToken, separate model since
// it's a distinct flow (forgot-password) with its own short expiry (1h) —
// mixing the two under one polymorphic table would obscure which flow a row
// belongs to for no real gain.
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// Stateful refresh tokens: one row per session/device (a login never revokes
// another session's row). The raw token is never stored — only its SHA-256
// hash, so a leaked database can't be used to forge sessions. `refresh`
// rotates: the presented row is marked revoked and linked via
// `replacedByTokenId` to the row created in its place. A revoked row being
// presented again (token-reuse) is a theft signal — AuthService responds by
// revoking every other active session for that user.
// Expired/revoked rows are pruned by a future scheduled job, not on read.
model RefreshToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?

  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Car {
  id String @id @default(uuid())

  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id])

  // No soft-delete on Car (see docs/architecture.md § Soft delete), so these
  // are plain unique constraints (scoped per agency, not global — two
  // different agencies can each have their own "123 TUN 4567") — unlike the
  // partial "unique among non-archived rows" indexes Client/etc. still need.
  licensePlate  String
  vin           String?
  brand         String
  model         String
  year          Int
  color         String
  category      CarCategory
  transmission  Transmission
  fuelType      FuelType
  seats         Int
  mileage       Int
  dailyRate     Decimal      @db.Decimal(10, 3)
  status        CarStatus    @default(AVAILABLE)
  purchaseDate  DateTime?
  purchasePrice Decimal?     @db.Decimal(10, 3)

  // Reminder-ready fields (no reminder UI/scheduler in v1, see docs/architecture.md §1)
  insuranceExpiryDate           DateTime?
  technicalInspectionExpiryDate DateTime?
  registrationExpiryDate        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images             CarImage[]
  rentals            Rental[]
  maintenanceRecords MaintenanceRecord[]
  expenses           Expense[]

  @@unique([agencyId, licensePlate])
  @@unique([agencyId, vin])
  @@index([agencyId, status])
  @@map("cars")
}

model CarImage {
  id        String   @id @default(uuid())
  carId     String
  car       Car      @relation(fields: [carId], references: [id])
  url       String
  publicId  String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([carId])
  @@map("car_images")
}

model Client {
  id String @id @default(uuid())

  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id])

  firstName            String
  lastName             String
  // No soft-delete on Client (see docs/architecture.md § Soft delete) — like
  // Car, this is now a plain unique constraint (scoped per agency, not
  // global) rather than the partial "unique among non-archived rows" index
  // it used to be. A nullable email still allows multiple NULLs, same as
  // Car.vin.
  email                String?
  phone                String
  nationality          String?
  address              String?
  city                 String?
  nationalIdNumber     String?
  drivingLicenseNumber String
  drivingLicenseExpiry DateTime?
  dateOfBirth          DateTime?
  notes                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents ClientDocument[]
  rentals   Rental[]

  @@unique([agencyId, email])
  @@index([agencyId, phone])
  @@map("clients")
}

model ClientDocument {
  id        String             @id @default(uuid())
  clientId  String
  client    Client             @relation(fields: [clientId], references: [id])
  type      ClientDocumentType
  url       String
  publicId  String
  createdAt DateTime           @default(now())

  @@index([clientId])
  @@map("client_documents")
}

model Rental {
  id           String @id @default(uuid())
  rentalNumber String

  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id])

  carId String
  car   Car    @relation(fields: [carId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  pickupDate        DateTime
  plannedReturnDate DateTime
  actualReturnDate  DateTime?

  // The rate actually charged: Car.dailyRate at creation time, or a price
  // negotiated for this rental only. Snapshotted so a later price change
  // never retroactively alters an existing contract/report.
  dailyRate        Decimal @db.Decimal(10, 3)
  // Car.dailyRate as it stood at creation — kept alongside dailyRate so a
  // negotiated price stays visible as such even after the car's own rate
  // changes.
  catalogDailyRate Decimal @db.Decimal(10, 3)
  totalAmount      Decimal @db.Decimal(10, 3)
  depositAmount    Decimal @db.Decimal(10, 3)
  depositReturned  Boolean @default(false)

  mileageAtPickup   Int?
  mileageAtReturn   Int?
  fuelLevelAtPickup String?
  fuelLevelAtReturn String?

  status          RentalStatus @default(RESERVED)
  cancelledReason String?
  notes           String?

  createdByUserId String
  createdBy       User   @relation("RentalCreatedBy", fields: [createdByUserId], references: [id])

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  extensions RentalExtension[]
  payments   Payment[]
  contract   ContractDocument?

  @@unique([agencyId, rentalNumber])
  @@index([agencyId, status])
  @@index([carId, pickupDate, plannedReturnDate])
  @@index([clientId])
  @@index([deletedAt])
  @@map("rentals")
}

model RentalExtension {
  id                 String   @id @default(uuid())
  rentalId           String
  rental             Rental   @relation(fields: [rentalId], references: [id])
  previousReturnDate DateTime
  newReturnDate      DateTime
  additionalAmount   Decimal  @db.Decimal(10, 3)
  createdAt          DateTime @default(now())

  @@index([rentalId])
  @@map("rental_extensions")
}

model Payment {
  id String @id @default(uuid())

  // Denormalized from Payment.rental.agencyId — every Payment query in
  // Finances lists/aggregates across rentals, so scoping directly here
  // avoids joining through Rental just to filter by tenant.
  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id])

  rentalId String
  rental   Rental @relation(fields: [rentalId], references: [id])

  amount Decimal       @db.Decimal(10, 3)
  method PaymentMethod
  type   PaymentType
  status PaymentStatus @default(COMPLETED)
  paidAt DateTime?
  notes  String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())

  attachments PaymentAttachment[]

  @@index([agencyId, type])
  @@index([rentalId])
  @@index([deletedAt])
  @@map("payments")
}

// Optional photos for a payment — used in practice for DAMAGE_FEE payments
// recorded at rental return.
model PaymentAttachment {
  id        String   @id @default(uuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id])
  url       String
  publicId  String
  createdAt DateTime @default(now())

  @@index([paymentId])
  @@map("payment_attachments")
}

model ContractDocument {
  id          String   @id @default(uuid())
  rentalId    String   @unique
  rental      Rental   @relation(fields: [rentalId], references: [id])
  pdfUrl      String
  publicId    String
  language    String
  generatedAt DateTime @default(now())

  @@map("contract_documents")
}

model Expense {
  id String @id @default(uuid())

  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id])

  category    ExpenseCategory
  amount      Decimal         @db.Decimal(10, 3)
  carId       String?
  car         Car?            @relation(fields: [carId], references: [id])
  description String
  date        DateTime
  receiptUrl  String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([agencyId])
  @@index([carId])
  @@index([date])
  @@index([deletedAt])
  @@map("expenses")
}

model MaintenanceRecord {
  id               String          @id @default(uuid())
  carId            String
  car              Car             @relation(fields: [carId], references: [id])
  type             MaintenanceType
  description      String?
  cost             Decimal         @db.Decimal(10, 3)
  mileageAtService Int
  serviceDate      DateTime
  nextDueDate      DateTime?
  nextDueMileage   Int?
  garageName       String?
  invoiceUrl       String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([carId])
  @@index([deletedAt])
  @@map("maintenance_records")
}

// One row per agency (created at registration, see AuthService.register) —
// this is the agency's "Profil" record, the one place its display identity
// (name, address, logo...) actually lives (see Agency's own comment).
model Setting {
  id String @id @default(uuid())

  agencyId String @unique
  agency   Agency @relation(fields: [agencyId], references: [id])

  agencyName             String
  // When the agency itself was founded — purely informational (e.g. "since
  // 2015" on documents), unrelated to `createdAt` which is this row's own
  // creation timestamp.
  foundedAt              DateTime?
  address                String?
  phone                  String?
  email                  String?
  logoUrl                String?
  // IBAN (or Tunisian RIB) for bank transfers — deposit refunds, invoices.
  iban                   String?
  currencyCode           String    @default("TND")
  defaultDepositAmount   Decimal   @default(0) @db.Decimal(10, 3)
  taxId                  String?
  // How many days ahead the notification bell (RemindersService) looks for
  // upcoming expiries — previously the frontend's own hardcoded
  // REMINDERS_WITHIN_DAYS constant, now a per-agency setting.
  reminderWindowDays     Int       @default(7)
  // An expense at or above this amount, recorded by an employee, waits for
  // the director's approval before it exists (ApprovalsService).
  largeExpenseThreshold  Decimal   @default(500) @db.Decimal(10, 3)
  // A rental priced more than this many percent below the car's catalogue
  // rate, booked by an employee, waits for the director's approval.
  largeDiscountThreshold Int       @default(15)
  updatedAt              DateTime  @updatedAt

  @@map("settings")
}

model AuditLog {
  id       String  @id @default(uuid())
  userId   String?
  user     User?   @relation(fields: [userId], references: [id])
  // The agency the action happened in — what the director's activity journal
  // filters on. New rows always carry it (AuditService.record).
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  action         String
  entityType     String?
  entityId       String?
  previousValues Json?
  newValues      Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([agencyId, createdAt])
  @@map("audit_logs")
}

// The three actions an employee can't do alone: changing a car's catalogue
// rate, recording a large expense, booking at a large discount. The action
// doesn't exist until the director approves — `payload` is the employee's
// original, already-validated request, re-validated and executed on their
// behalf at approval (ApprovalsService.approve).
enum ApprovalType {
  CAR_PRICE_CHANGE
  LARGE_EXPENSE
  LARGE_DISCOUNT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

model ApprovalRequest {
  id String @id @default(uuid())

  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id])

  type     ApprovalType
  status   ApprovalStatus @default(PENDING)
  // The request body as the employee sent it (dates as ISO strings).
  payload  Json
  // What the director needs to decide, frozen at request time (car, client,
  // amounts, rates) — shown as is, even if the records change since.
  summary  Json
  // The car whose rate would change; for the other types, the rental or
  // expense created once approved.
  entityId String?

  requestedById   String
  requestedBy     User      @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  decidedById     String?
  decidedBy       User?     @relation("ApprovalDecidedBy", fields: [decidedById], references: [id])
  decidedAt       DateTime?
  // When the employee saw the decision (their notification bell).
  requesterSeenAt DateTime?
  createdAt       DateTime  @default(now())

  @@index([agencyId, status, createdAt])
  @@index([requestedById, createdAt])
  @@map("approval_requests")
}
