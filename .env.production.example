# Copy to `.env` on the VPS (same directory as docker-compose.prod.yml) and
# fill in real values. Never commit the real `.env` — see .gitignore.

# Your domain, no protocol (e.g. "agence.tn" or "app.agence.tn") — must
# already point (DNS A record) at this VPS before first boot, so Caddy can
# obtain its Let's Encrypt certificate.
DOMAIN=

# Postgres password (pick your own — this is a fresh database, not migrating
# an existing one).
POSTGRES_PASSWORD=

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Resend (see docs/deployment.md "Production (OVH)" — sign up, verify your
# domain, then paste the API key here).
RESEND_API_KEY=
EMAIL_FROM="Agence <noreply@your-domain>"

# Cloudinary (car/client document photos) — leave blank only if you haven't
# set this feature up yet; uploads will fail without it.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
